PORT=5000
NODE_ENV=development
# For transactions, MongoDB requires a replica set (e.g. rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/evora
JWT_SECRET=
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
CLIENT_URL=http://localhost:5173
# Seed only a disposable local database. The seed script deletes all collections.
ALLOW_DESTRUCTIVE_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
