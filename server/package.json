{
  "name": "evora-server",
  "version": "1.0.0",
  "description": "EVora - AI-powered EV Recommendation System Backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "server": "npm run dev",
    "client": "npm --prefix ../client run dev",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check-rs": "node src/scripts/checkReplicaSet.js",
    "init-rs": "node src/scripts/initReplicaSet.js",
    "seed": "node src/scripts/seed.js",
    "enrich:evs": "node src/scripts/enrichEvSpecs.js",
    "verify-db": "node src/scripts/verifyDb.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1"
  }
}
